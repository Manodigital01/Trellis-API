{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trellis.stellar/schemas/protocol-changes.schema.json",
  "title": "Trellis API protocol changelog",
  "description": "Machine-readable record of protocol-facing behaviour changes: HTTP routes, WebSocket/GraphQL surfaces, configuration keys and operator-facing commands. Every entry states the release version, the impact on existing callers, the migration that applies and the date the change shipped.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "entries"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema, for editor and pipeline tooling."
    },
    "schemaVersion": {
      "type": "string",
      "description": "Version of this schema, not of the API.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "description": "Optional ISO-8601 timestamp of the last manual regeneration.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "calendarDate": {
      "type": "string",
      "description": "Calendar date in UTC, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "issueNumber": {
      "type": "integer",
      "minimum": 1
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "date",
        "status",
        "impact",
        "title",
        "summary",
        "protocolSurfaces",
        "migration"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "date": { "$ref": "#/$defs/calendarDate" },
        "status": {
          "type": "string",
          "enum": ["released", "unreleased"],
          "description": "`unreleased` marks work that is merged but not yet cut as a release."
        },
        "impact": {
          "type": "string",
          "enum": [
            "breaking",
            "deprecation",
            "compatible",
            "fix",
            "security"
          ],
          "description": "Worst-case effect on an existing caller that does nothing."
        },
        "title": { "type": "string", "minLength": 4 },
        "summary": { "type": "string", "minLength": 10 },
        "protocolSurfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/protocolSurface" }
        },
        "migration": { "$ref": "#/$defs/migration" },
        "breakingChanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/breakingChange" }
        },
        "deprecations": {
          "type": "array",
          "items": { "$ref": "#/$defs/deprecation" }
        },
        "relatedIssues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issueNumber" }
        },
        "relatedPullRequests": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "docs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Repository-relative documentation paths."
        }
      }
    },
    "protocolSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "http",
            "websocket",
            "graphql",
            "event",
            "config",
            "cli",
            "database"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS",
            "HEAD"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Route path, GraphQL field or topic. Required for http, websocket and graphql."
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Configuration key or environment variable. Required for config."
        },
        "description": { "type": "string", "minLength": 4 }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "automated", "steps", "notes"],
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Whether a caller or operator must do something before or after upgrading."
        },
        "automated": {
          "type": "boolean",
          "description": "Whether the migration is applied by tooling (a TypeORM migration, a deploy script) rather than by hand."
        },
        "steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 4 },
          "description": "Ordered, imperative steps. Must be non-empty when `required` is true."
        },
        "notes": { "type": "string", "minLength": 4 }
      }
    },
    "breakingChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 4 },
        "replacement": { "type": "string", "minLength": 1 },
        "issue": { "$ref": "#/$defs/issueNumber" }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "replacement", "removalVersion"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string", "minLength": 1 },
        "removalVersion": { "$ref": "#/$defs/semver" }
      }
    }
  }
}
